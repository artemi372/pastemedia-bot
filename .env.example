# Bot token from @BotFather
BOT_TOKEN=

# Private channel where the bot is an admin (id like -100...): videos are uploaded there once
STORAGE_CHAT_ID=

# Developers: Telegram user IDs, comma-separated (send /id to the bot). They get /broadcast,
# /reload, /stop and the moderation commands. Nobody else sees these commands.
DEV_IDS=

# Language for chats that haven't chosen one: en, ru or et
DEFAULT_LANG=en

# Bot messages and commands in groups delete themselves after a while: 1 — on, 0 — off.
# Private chats are never cleaned up.
AUTO_DELETE=1

# Author contacts shown in /start, /help, the bot profile and on errors. Empty = hidden.
AUTHOR_TELEGRAM=artemi372
AUTHOR_GITHUB=artemi372

# Links to your privacy policy and terms of use (/privacy, /terms, /help, bot profile).
# Telegram requires a privacy policy; set your own when running your own copy. Empty = hidden.
PRIVACY_URL=https://telegra.ph/Media-Paste-Bot--Privacy-Policy-10-07
TERMS_URL=https://telegra.ph/Media-Paste-Bot--Terms-of-Use-10-07

# Optional custom (Telegram Premium) emoji for the reactions on link messages. Telegram lets a bot
# use one only in groups whose admins added that emoji to the allowed reactions (never in private
# chats); everywhere else the standard emoji is used: 👀 working, 🤷 failed, 🙈 live stream,
# 🤨 an account instead of a video. The id is the custom_emoji_id of the emoji (forward a message
# with it to @idstickerbot or similar to find it). Empty = standard emoji only.
REACTION_WORKING_ID=
REACTION_FAILED_ID=
REACTION_LIVE_ID=
REACTION_PROFILE_ID=
